<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wiz_bringup</name>
  <version>0.3.0</version>
  <description>Launch files for starting the Wiz ROS 2 nodes together</description>
  <maintainer email="arnavkatewale@gmail.com">arnav</maintainer>
  <license>TBD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>wiz_status</exec_depend>
  <exec_depend>wiz_vision</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
